# Application Settings
DEBUG=True

# Security - Generate a secret key using: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# JWT & Authentication Configuration
# Access token lifetime in minutes (Short-lived: 5-15 min)
JWT_ACCESS_TOKEN_LIFETIME=15
# Refresh token lifetime in minutes (7 days = 10080 minutes)
JWT_REFRESH_TOKEN_LIFETIME=10080
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting Configuration
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# MongoDB Configuration
# IMPORTANT: The password in the URI must be URL-encoded!
# Use Python to encode: from urllib.parse import quote_plus; print(quote_plus("your-password"))
MONGODB_URI=mongodb+srv://username:ENCODED_PASSWORD_HERE@cluster0.bnltfut.mongodb.net/
MONGODB_NAME=artisa_db

# CORS Configuration (comma-separated list of trusted origins, never use wildcard '*' with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth Cookies (HttpOnly Refresh Token & Session Management)
# Local HTTP dev (frontend + backend on localhost, different ports):
#   COOKIE_SECURE=False
#   COOKIE_SAMESITE=lax
# Production (frontend and backend on HTTPS):
#   COOKIE_SECURE=True
#   COOKIE_SAMESITE=none (or lax if on same site/custom subdomains)
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
# Optional: share cookie across subdomains, e.g. ".artisa.com"
COOKIE_DOMAIN=

GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Artisa <onboarding@resend.dev>
EMAIL_FROM=Artisa <onboarding@resend.dev>

# Vercel Blob (product image storage)
BLOB_STORE_ID=your_blob_store_id
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token
